# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — never commit real values/secrets.

aws_region             = "ap-south-1"
project_name           = "datalake-iceberg-series"
environment             = "workshop"

vpc_id                 = "vpc-xxxxxxxx"
subnet_id               = "subnet-xxxxxxxx"

ec2_instance_type      = "t3.medium"
key_pair_name           = "my-ec2-keypair"

data_lake_bucket_name  = "my-unique-datalake-iceberg-bucket" # must be globally unique
glue_database_name      = "datalake_iceberg_series"
